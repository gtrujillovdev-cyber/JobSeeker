# ==========================================
# Configuración de JobSeekerGA
# ==========================================

# Modo Headless del navegador (true para producción en background, false para debug visual)
HEADLESS_BROWSER=true

# Límite máximo de publicaciones diarias en LinkedIn (Recomendado: 1 o 2)
MAX_DAILY_POSTS=2

# API Key de Gemini para generación de copy técnico
GEMINI_API_KEY=

# Notificaciones opcionales por Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Job Scanner - Radar de ofertas (separar multiples queries con |)
JOB_SEARCH_KEYWORDS=Python Developer
JOB_SEARCH_LOCATION=Spain
JOB_SCAN_MAX_RESULTS=15

# Engagement Engine - Limites diarios de seguridad anti-ban
MAX_DAILY_CONNECTIONS=5
MAX_DAILY_COMMENTS=8
MAX_DAILY_REACTIONS=15
